{
  "name": "maniple",
  "displayName": "Maniple",
  "version": "1.0.5",
  "description": "Start and continue your Maniple applications from your coding agent, governed by your organisation's standards.",
  "author": {
    "name": "Maniple",
    "url": "https://maniple.ai"
  },
  "homepage": "https://maniple.ai",
  "repository": "https://github.com/ManipleAI/maniple-plugins",
  "license": "MIT",
  "keywords": [
    "maniple",
    "governance",
    "citizen-developer",
    "mcp"
  ],
  "icon": "assets/icon.png",
  "privacyPolicyUrl": "https://github.com/ManipleAI/maniple-plugins/blob/main/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/ManipleAI/maniple-plugins/blob/main/TERMS.md",
  "supportUrl": "https://github.com/ManipleAI/maniple-plugins/issues",
  "documentationUrl": "https://github.com/ManipleAI/maniple-plugins#readme",
  "userConfig": {
    "maniple_url": {
      "type": "string",
      "title": "Your Maniple address",
      "description": "Your organisation's Maniple, for example https://maniple.example.com",
      "required": true
    }
  },
  "mcpServers": {
    "maniple": {
      "type": "http",
      "url": "${user_config.maniple_url}/mcp"
    }
  }
}
